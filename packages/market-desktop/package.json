{
  "name": "@cadrel/market-desktop",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "pack": "node scripts/build.mjs && electron-builder --dir --publish never",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.9",
    "sharp": "^0.34.0",
    "tesseract.js": "^6.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "^4.10.38",
    "@huggingface/transformers": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.9.0",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@cadrel/market-core": "*",
    "@cadrel/market-library": "*",
    "@cadrel/market-server": "*",
    "@cadrel/market-embedder": "*",
    "@cadrel/market-text": "*",
    "electron-builder": "^26.0.0",
    "fflate": "^0.8.2",
    "pdfkit": "^0.15.0",
    "@types/pdfkit": "^0.13.0"
  },
  "author": "BookScout",
  "description": "Local market research for Amazon Kindle books"
