{
  "name": "@cadrel/shell",
  "version": "0.1.0",
  "private": true,
  "description": "Cadrel: the studio suite",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "version:sync": "node scripts/sync-version.mjs",
    "pack": "node scripts/sync-version.mjs && node scripts/build.mjs && electron-builder --dir --publish never",
    "dist": "node scripts/sync-version.mjs && node scripts/build.mjs && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.34.0",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@cadrel/kernel": "*",
    "@cadrel/market-desktop": "*",
    "@cadrel/market-mcp": "*",
    "@cadrel/write": "*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.0",
    "fflate": "^0.8.2",
    "playwright-core": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  },
  "author": "blaashford-ux"
}
