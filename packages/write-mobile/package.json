{
  "name": "@cadrel/write-mobile",
  "version": "0.7.4",
  "description": "Cadrel Write for Android: the writing interface on its own, connected to a Cadrel Studio. Imports @cadrel/write; shares the Studio client with the desktop app.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cadrel/kernel": "*",
    "@cadrel/service": "*",
    "@cadrel/studio-client": "*",
    "@cadrel/worker": "*",
    "@cadrel/write": "*",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "author": "blaashford-ux",
  "homepage": "https://github.com/blaashford-ux/cadrel"
}
