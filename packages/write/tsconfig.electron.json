{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "electron",
    "mcp",
    "src/shared"
  ],
  "exclude": [
    "electron/**/*.test.ts",
    "mcp/**/*.test.ts"
  ]
}
